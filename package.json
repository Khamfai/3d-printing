{
  "name": "3d-printing-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push && bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev && bunx prisma generate",
    "db:seed": "bun run prisma/seed.ts",
    "db:studio": "bunx prisma studio",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs 3d-printing-api"
  },
  "dependencies": {
    "elysia": "^1.4.25",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/bearer": "^1.4.3",
    "@elysiajs/swagger": "^1.3.1",
    "@elysiajs/static": "^1.4.7",
    "@prisma/client": "^7.4.1",
    "@prisma/adapter-pg": "^7.4.1",
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "stripe": "^20.3.1",
    "resend": "^6.9.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint__js": "^9.14.0",
    "bun-types": "latest",
    "eslint": "^10.0.1",
    "pm2": "^6.0.14",
    "prettier": "^3.8.1",
    "prisma": "^7.4.1",
    "typescript-eslint": "^8.56.0"
  },
  "module": "src/index.ts"
}
